---
interface NavItem {
  label: string;
  href: string;
}

const navItems: NavItem[] = [
  {
    label: "Inicio",
    href: "#home",
  },
  {
    label: "Tecnologias",
    href: "#technologies",
  },
  {
    label: "Proyectos",
    href: "#projects",
  },
  {
    label: "Contacto",
    href: "#contact",
  },
  {
    label: "Sobre mi",
    href: "#about-me",
  },
];
---

<header
  id="nav-header"
  class="fixed left-0 right-0 z-[100] flex justify-center pointer-events-none md:top-6 bottom-7 sm:bottom-8 md:bottom-auto px-2 sm:px-4"
>
  <nav
    id="main-nav"
    class="pointer-events-auto w-fit max-w-full px-3 sm:px-5 md:px-7 py-2 md:py-2.5 rounded-full border border-white/10 backdrop-blur-xl transition-[background-color,border-color,box-shadow] duration-300 ease-out shadow-lg"
  >
    <ul class="flex items-center justify-center gap-1 sm:gap-3 md:gap-8 whitespace-nowrap">
      {
        navItems.map((item) => (
          <li class="flex-shrink-0">
            <a
              href={item.href}
              class="flex items-center text-[#dfdfdf] hover:text-white transition-colors text-xs sm:text-sm md:text-base relative group py-1 px-1.5 sm:px-2 md:px-2.5 font-medium"
            >
              <span>{item.label}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  nav {
    background-color: var(--component-bg, #141414e6);
    border-color: rgba(255, 255, 255, 0.1);
    box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.6);
    transition:
      background-color 0.3s ease,
      border-color 0.3s ease,
      box-shadow 0.3s ease;
  }

  nav.scrolling {
    background-color: var(--component-bg, #141414f2);
    border-color: rgba(255, 255, 255, 0.15);
    box-shadow: 0 12px 35px -10px rgba(0, 0, 0, 0.7);
  }

  nav a {
    color: #dfdfdf;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
  }

  nav a:hover {
    color: #ffffff;
  }

  nav a.active {
    color: var(--sec-bright, #5275FF) !important;
    font-weight: 600;
  }

  @media (max-width: 370px) {
    nav a {
      font-size: 11px;
      padding-left: 3px;
      padding-right: 3px;
    }
  }

  @media (max-width: 767px) {
    #nav-header {
      top: auto !important;
      bottom: 2rem !important;
      bottom: max(2rem, calc(1.5rem + env(safe-area-inset-bottom, 0px))) !important;
    }

    :global(body) {
      padding-bottom: 100px;
    }
  }
</style>

<script>
  const nav = document.getElementById("main-nav");

  function updateNav() {
    if (!nav || window.innerWidth < 768) return;
    if (window.scrollY > 20) {
      nav.classList.add("scrolling");
    } else {
      nav.classList.remove("scrolling");
    }
  }

  window.addEventListener("scroll", updateNav, { passive: true });
  updateNav();

  document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
    anchor.addEventListener("click", function (e) {
      e.preventDefault();
      const target = e.currentTarget as HTMLAnchorElement;
      const targetId = target.getAttribute("href")?.substring(1) || "";
      const targetElement = document.getElementById(targetId);
      if (targetElement) {
        targetElement.scrollIntoView({
          behavior: "smooth",
          block: "start",
        });
      }
    });
  });

  document.addEventListener("DOMContentLoaded", () => {
    updateNav();
    const sections = document.querySelectorAll("section[id]");
    const navLinks = document.querySelectorAll("nav a[href^='#']");
    const observerOptions = {
      rootMargin: "-15% 0px -40% 0px",
      threshold: 0,
    };

    const observerCallback = (entries: IntersectionObserverEntry[]) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          navLinks.forEach((link) => link.classList.remove("active"));
          const id = entry.target.getAttribute("id");
          const activeLink = document.querySelector(`nav a[href="#${id}"]`);
          if (activeLink) {
            activeLink.classList.add("active");
          }
        }
      });
    };

    const observer = new IntersectionObserver(
      observerCallback,
      observerOptions
    );
    sections.forEach((section) => observer.observe(section));
  });
</script>
