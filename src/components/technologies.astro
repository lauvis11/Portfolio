---
interface TechItem {
  name: string;
  icon?: string;
}

interface TechCategory {
  title: string;
  skills: TechItem[];
}

const stack: TechCategory[] = [
  {
    title: "FRONTEND",
    skills: [
      { name: "JavaScript", icon: "/svg/javaScript.svg" },
      { name: "TypeScript", icon: "/svg/typeScript.svg" },
      { name: "React", icon: "/svg/react.svg" },
      { name: "Next.Js", icon: "/svg/next.svg" },
      { name: "Astro", icon: "/svg/astro.svg" },
      { name: "Tailwind CSS", icon: "/svg/tailwindcss.svg" },
      { name: "CSS", icon: "/svg/CSS3.svg" },
    ],
  },
  {
    title: "BACKEND",
    skills: [
      { name: "Node.Js", icon: "/svg/nodejs.svg" },
      { name: "Express.Js", icon: "/svg/express.svg" },
      { name: "Python", icon: "/svg/python.svg" },
      { name: "FastAPI", icon: "/svg/fastapi.svg" },
      { name: "Supabase", icon: "/svg/supabase.svg" },
    ],
  },
  {
    title: "DATABASE",
    skills: [
      { name: "MySQL", icon: "/svg/mysql.svg" },
      { name: "PostgreSQL", icon: "/svg/postgresql.svg" },
      { name: "SQLite", icon: "/svg/sqlite.svg" },
    ],
  },
  {
    title: "HERRAMIENTAS",
    skills: [
      { name: "Git", icon: "/svg/git.svg" },
      { name: "GitHub", icon: "/svg/github.svg" },
      { name: "Stitch", icon: "/svg/stitch.png" },
    ],
  },
];
---

<section
  id="technologies"
  class="pt-10 md:pt-14 pb-16 md:pb-24 border-t border-[#ffffff10] text-[var(--white)] relative reveal-section"
>
  <div class="max-w-5xl mx-auto">
    <h2 class="text-lg text-[var(--sec)] mb-2 shiny-sec">Mi stack de Tecnologías</h2>
    <h3 class="text-4xl md:text-5xl font-medium mb-12 md:mb-16">Habilidades</h3>

    <div class="space-y-16 md:space-y-24">
      {
        stack.map((category) => (
          <div class="flex flex-col lg:flex-row lg:items-start justify-between gap-8">
            <div class="flex-shrink-0 lg:-translate-x-4">
              <h3 class="category-title text-2xl md:text-3xl lg:text-4xl font-bold uppercase tracking-wider text-zinc-400 hover:text-white transition-colors duration-300">
                {category.title}
              </h3>
            </div>

            <div class="w-full lg:w-[560px] lg:ml-auto grid grid-cols-2 sm:grid-cols-3 gap-y-7 gap-x-6 md:gap-x-8">
              {category.skills.map((skill) => (
                <div class="flex items-center gap-3.5 group cursor-default">
                  {skill.icon && (
                    <div class="size-8 md:size-9 flex items-center justify-center flex-shrink-0">
                      <img
                        src={skill.icon}
                        alt={skill.name}
                        class="size-7 md:size-8 object-contain"
                        width="32"
                        height="32"
                        loading="lazy"
                        decoding="async"
                      />
                    </div>
                  )}
                  <span class="text-sm md:text-base lg:text-lg font-medium text-[#e4e4e7] group-hover:text-white transition-colors whitespace-nowrap">
                    {skill.name}
                  </span>
                </div>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .category-title {
    font-family: "Space Grotesk", "Outfit", "Montserrat Variable", sans-serif;
    letter-spacing: 0.08em;
  }
</style>
