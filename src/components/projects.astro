---
interface ProjectTech {
  name: string;
  icon: string;
}

interface Project {
  title: string;
  image: string;
  link?: string;
  preview: string;
  status: string;
  description: string;
  technologies?: ProjectTech[];
}

const projects: Project[] = [
  {
    title: "E-commerce NexusPc",
    image: "https://placehold.co/600x400/18181b/2D4CFC?text=Proyecto+1",
    link: "https://github.com/lauvis11/NexusPc",
    preview: "https://nexus-pc-front-bay.vercel.app",
    status: "Completado",
    description:
      "Tienda e-commerce que simula el flujo completo de una tienda online real: catálogo de productos, carrito de compras y pasarela de pagos. Proyecto desarrollado con fines demostrativos para exhibir habilidades técnicas en desarrollo fullstack.",
    technologies: [
      { name: "Next.js", icon: "/svg/next.svg" },
      { name: "TypeScript", icon: "/svg/typeScript.svg" },
      { name: "Tailwind CSS", icon: "/svg/tailwindcss.svg" },
      { name: "Express.js", icon: "/svg/express.svg" },
      { name: "PostgreSQL", icon: "/svg/postgresql.svg" },
    ],
  },
  {
    title: "BookReview",
    image: "https://placehold.co/600x400/18181b/2D4CFC?text=Proyecto+2",
    link: "https://github.com/lauvis11/BookReview",
    preview: "https://book-review-api-liart.vercel.app",
    status: "Completado",
    description:
      "Pagina web de reseñas de libros con Asistente Personal de Inteligencia Artificial. Permite a los usuarios llevar un registro detallado de sus hábitos de lectura, interactuar con una comunidad a través de reseñas y calificaciones, y obtener recomendaciones y análisis profundos de libros gracias a un asistente de IA.",
    technologies: [
      { name: "React", icon: "/svg/react.svg" },
      { name: "JavaScript", icon: "/svg/javaScript.svg" },
      { name: "Tailwind CSS", icon: "/svg/tailwindcss.svg" },
      { name: "Express.js", icon: "/svg/express.svg" },
      { name: "MySQL", icon: "/svg/mysql.svg" },
    ],
  },
  {
    title: "Pagina web UDT",
    image: "https://placehold.co/600x400/18181b/2D4CFC?text=Proyecto+3",
    preview: "#",
    status: "Completo",
    description:
      "Pagina web institutiva para un Sindicato de docentes, incluye blog de noticias y comunicado, gestión de directivos, inscripciones a cursos e información de contacto",
    technologies: [
      { name: "React", icon: "/svg/react.svg" },
      { name: "JavaScript", icon: "/svg/javaScript.svg" },
      { name: "CSS", icon: "/svg/CSS3.svg" },
      { name: "Express.js", icon: "/svg/express.svg" },
      { name: "MySQL", icon: "/svg/mysql.svg" },
    ],
  },
  {
    title: "Proyecto Cuatro",
    image: "https://placehold.co/600x400/18181b/2D4CFC?text=Proyecto+4",
    link: "https://github.com/lauvis11",
    preview: "#",
    status: "Completado",
    description:
      "API REST escalable y segura desarrollada con Python y FastAPI, integrada con persistencia relacional en PostgreSQL y consultas optimizadas para alto volumen de peticiones.",
    technologies: [
      { name: "Python", icon: "/svg/python.svg" },
      { name: "FastAPI", icon: "/svg/fastapi.svg" },
      { name: "PostgreSQL", icon: "/svg/postgresql.svg" },
    ],
  },
];
---

<section
  id="projects"
  class="py-12 border-t border-[#ffffff10] text-[var(--white)] reveal-section"
>
  <div class="max-w-5xl mx-auto">
    <h2 class="text-lg text-[var(--sec)] mb-2 shiny-sec">Mis trabajos</h2>
    <h3 class="text-4xl md:text-5xl font-medium mb-8">Proyectos</h3>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {
        projects.map((project) => (
          <div
            class="project-card"
            data-project={JSON.stringify(project)}
          >
            <div class="block">
              <div class="group cursor-pointer relative rounded-2xl overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-300 mb-4 bg-[#141414] border border-[#ffffff0f] hover:border-[var(--sec)]/40">
                <img
                  src={project.image}
                  alt={project.title}
                  class="w-full h-48 md:h-72 object-cover"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-4">
                  <span class="text-xs font-medium text-white/95 bg-black/70 backdrop-blur-md px-3 py-1.5 rounded-full border border-white/15 flex items-center gap-1.5 shadow-lg">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 20 20"
                      fill="currentColor"
                      class="size-3.5 text-[var(--sec-bright)]"
                    >
                      <path d="M10 12.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z" />
                      <path
                        fill-rule="evenodd"
                        d="M.664 10.59a1.651 1.651 0 0 1 0-1.186A10.004 10.004 0 0 1 10 3c4.257 0 7.893 2.66 9.336 6.41.147.381.146.804 0 1.186A10.004 10.004 0 0 1 10 17c-4.257 0-7.893-2.66-9.336-6.41ZM14 10a4 4 0 1 1-8 0 4 4 0 0 1 8 0Z"
                        clip-rule="evenodd"
                      />
                    </svg>
                    Ver detalles
                  </span>
                </div>
              </div>

              <div class="flex items-center px-3">
                <div class="flex-grow">
                  <h4 class="text-2xl font-semibold hover:text-[var(--sec-bright)] transition-colors duration-200 cursor-pointer">
                    {project.title}
                  </h4>
                  <span class="py-1 text-sm text-[var(--white-icon)]">
                    {project.status}
                  </span>
                </div>

                <div class="flex gap-2 ml-auto flex-shrink-0">
                  {
                    project.link && project.link !== "#" && project.link !== "" && (
                      <a
                        target="_blank"
                        rel="noopener noreferrer"
                        href={project.link}
                        aria-label="GitHub"
                        title="Ver código en GitHub"
                        class="project-direct-btn size-12 md:size-14 flex justify-center items-center text-[var(--white-icon)] hover:text-white transition duration-300 ease-in-out border border-[var(--white-icon-tr)] p-3 rounded-xl bg-[#1414149c] hover:bg-[var(--white-icon-tr)]"
                      >
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          viewBox="0 0 24 24"
                          fill="currentColor"
                          class="size-6 md:size-7"
                        >
                          <path d="M24 12L18.3431 17.6569L16.9289 16.2426L21.1716 12L16.9289 7.75736L18.3431 6.34315L24 12ZM2.82843 12L7.07107 16.2426L5.65685 17.6569L0 12L5.65685 6.34315L7.07107 7.75736L2.82843 12ZM9.78845 21H7.66009L14.2116 3H16.3399L9.78845 21Z" />
                        </svg>
                      </a>
                    )
                  }

                  <a
                    target="_blank"
                    rel="noopener noreferrer"
                    href={project.preview}
                    aria-label="Preview"
                    title="Visitar sitio web"
                    class="project-direct-btn size-12 md:size-14 flex justify-center items-center text-[var(--white-icon)] hover:text-white transition duration-300 ease-in-out border border-[var(--white-icon-tr)] p-3 rounded-xl bg-[#1414149c] hover:bg-[var(--white-icon-tr)]"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                      class="size-6 md:size-7"
                    >
                      <path d="M16.0037 9.41421L7.39712 18.0208L5.98291 16.6066L14.5895 8H7.00373V6H18.0037V17H16.0037V9.41421Z" />
                    </svg>
                  </a>
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <a
      target="_blank"
      href="https://github.com/lauvis11"
      aria-label="GitHub"
      class="w-full flex items-center justify-center gap-2 mt-9 text-[var(--white-icon)] hover:text-white transition duration-300 ease-in-out border border-[var(--white-icon-tr)] p-3 rounded-full bg-[#1414149c] hover:bg-[var(--white-icon-tr)]"
    >
      <span class="md:text-lg text-md">Ver más proyectos en GitHub</span>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="currentColor"
        class="size-6"
      >
        <path
          d="M12.001 2C6.47598 2 2.00098 6.475 2.00098 12C2.00098 16.425 4.86348 20.1625 8.83848 21.4875C9.33848 21.575 9.52598 21.275 9.52598 21.0125C9.52598 20.775 9.51348 19.9875 9.51348 19.15C7.00098 19.6125 6.35098 18.5375 6.15098 17.975C6.03848 17.6875 5.55098 16.8 5.12598 16.5625C4.77598 16.375 4.27598 15.9125 5.11348 15.9C5.90098 15.8875 6.46348 16.625 6.65098 16.925C7.55098 18.4375 8.98848 18.0125 9.56348 17.75C9.65098 17.1 9.91348 16.6625 10.201 16.4125C7.97598 16.1625 5.65098 15.3 5.65098 11.475C5.65098 10.3875 6.03848 9.4875 6.67598 8.7875C6.57598 8.5375 6.22598 7.5125 6.77598 6.1375C6.77598 6.1375 7.61348 5.875 9.52598 7.1625C10.326 6.9375 11.176 6.825 12.026 6.825C12.876 6.825 13.726 6.9375 14.526 7.1625C16.4385 5.8625 17.276 6.1375 17.276 6.1375C17.826 7.5125 17.476 8.5375 17.376 8.7875C18.0135 9.4875 18.401 10.375 18.401 11.475C18.401 15.3125 16.0635 16.1625 13.8385 16.4125C14.201 16.725 14.5135 17.325 14.5135 18.2625C14.5135 19.6 14.501 20.675 14.501 21.0125C14.501 21.275 14.6885 21.5875 15.1885 21.4875C19.259 20.1133 21.9999 16.2963 22.001 12C22.001 6.475 17.526 2 12.001 2Z"
        ></path>
      </svg>
    </a>
  </div>
</section>


<div
  id="project-modal"
  class="fixed inset-0 z-[999] flex items-center justify-center p-4 sm:p-6 opacity-0 pointer-events-none transition-opacity duration-300 ease-out"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-title"
>
    <div
      id="modal-backdrop"
      class="absolute inset-0 bg-black/80 backdrop-blur-md transition-opacity duration-300"
    >
    </div>

    <div
      id="modal-card"
      class="relative w-full max-w-4xl max-h-[90vh] overflow-y-auto bg-[#121215] border border-[#ffffff1c] rounded-3xl shadow-2xl shadow-black/90 z-10 scale-95 transition-transform duration-300 ease-out"
    >
      <button
        id="modal-close-btn"
        type="button"
        aria-label="Cerrar modal"
        class="absolute top-4 right-4 z-20 size-10 flex items-center justify-center rounded-full bg-[#1b1b20] hover:bg-[#25252c] text-zinc-400 hover:text-white border border-[#ffffff15] transition-colors cursor-pointer"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="size-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M6 18L18 6M6 6l12 12"
          ></path>
        </svg>
      </button>

      <div class="grid grid-cols-1 md:grid-cols-12 min-h-[460px]">
        <div
          class="md:col-span-6 bg-[#0c0c0e] flex items-center justify-center p-6 md:p-8 border-b md:border-b-0 md:border-r border-[#ffffff10]"
        >
          <div
            class="w-full rounded-2xl overflow-hidden border border-[#ffffff12] shadow-xl bg-[#141414]"
          >
            <img
              id="modal-image"
              src=""
              alt=""
              class="w-full h-56 md:h-80 object-cover"
            />
          </div>
        </div>

        <div
          class="md:col-span-6 p-6 md:p-8 flex flex-col justify-between space-y-6"
        >
          <div class="space-y-4">
            <div class="flex items-center gap-2.5">
              <span
                id="modal-status"
                class="px-3 py-1 rounded-full text-xs font-semibold bg-[var(--sec)]/15 text-[var(--sec-bright)] border border-[var(--sec)]/30 tracking-wide"
              >
              </span>
            </div>

            <h3
              id="modal-title"
              class="text-2xl md:text-3xl font-bold text-white tracking-tight leading-tight"
            >
            </h3>

            <p
              id="modal-description"
              class="text-sm md:text-base text-zinc-300 leading-relaxed"
            >
            </p>

            <div class="pt-2">
              <h4
                class="text-xs uppercase tracking-wider font-semibold text-zinc-400 mb-3"
              >
                Tecnologías utilizadas
              </h4>
              <div id="modal-technologies" class="flex flex-wrap items-center gap-x-5 gap-y-3"></div>
            </div>
          </div>

          <div
            class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 pt-4 border-t border-[#ffffff10]"
          >
            <a
              id="modal-code-link"
              target="_blank"
              rel="noopener noreferrer"
              href="#"
              class="flex-1 flex items-center justify-center gap-2 px-4 py-3 rounded-xl border border-[var(--white-icon-tr)] bg-[#1414149c] hover:bg-[var(--white-icon-tr)] text-white text-sm font-medium transition duration-300 cursor-pointer"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="currentColor"
                class="size-5 text-[var(--sec-bright)]"
              >
                <path
                  d="M24 12L18.3431 17.6569L16.9289 16.2426L21.1716 12L16.9289 7.75736L18.3431 6.34315L24 12ZM2.82843 12L7.07107 16.2426L5.65685 17.6569L0 12L5.65685 6.34315L7.07107 7.75736L2.82843 12ZM9.78845 21H7.66009L14.2116 3H16.3399L9.78845 21Z"
                ></path>
              </svg>
              <span>Ver código</span>
            </a>

            <a
              id="modal-preview-link"
              target="_blank"
              rel="noopener noreferrer"
              href="#"
              class="flex-1 flex items-center justify-center gap-2 px-4 py-3 rounded-xl bg-[var(--sec)] hover:bg-[var(--sec-bright)] text-white text-sm font-medium shadow-lg shadow-[#2D4CFC]/25 transition duration-300 cursor-pointer"
            >
              <span>Ir a la web</span>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="currentColor"
                class="size-5"
              >
                <path
                  d="M16.0037 9.41421L7.39712 18.0208L5.98291 16.6066L14.5895 8H7.00373V6H18.0037V17H16.0037V9.41421Z"
                ></path>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

<script>
  function setupProjectModal() {
    const modal = document.getElementById("project-modal");
    const backdrop = document.getElementById("modal-backdrop");
    const closeBtn = document.getElementById("modal-close-btn");
    const modalCard = document.getElementById("modal-card");
    const modalImage = document.getElementById(
      "modal-image"
    ) as HTMLImageElement | null;
    const modalTitle = document.getElementById("modal-title");
    const modalStatus = document.getElementById("modal-status");
    const modalDescription = document.getElementById("modal-description");
    const modalTechContainer = document.getElementById("modal-technologies");
    const modalCodeLink = document.getElementById(
      "modal-code-link"
    ) as HTMLAnchorElement | null;
    const modalPreviewLink = document.getElementById(
      "modal-preview-link"
    ) as HTMLAnchorElement | null;

    if (!modal || !backdrop || !closeBtn || !modalCard) return;

    function openModal(data: any) {
      if (!modal || !modalCard) return;

      if (modalImage) {
        modalImage.src = data.image || "";
        modalImage.alt = data.title || "";
      }
      if (modalTitle) modalTitle.textContent = data.title || "";
      if (modalStatus) modalStatus.textContent = data.status || "";
      if (modalDescription) modalDescription.textContent = data.description || "";
      if (modalCodeLink) {
        if (data.link && data.link !== "#" && data.link !== "") {
          modalCodeLink.href = data.link;
          modalCodeLink.style.display = "flex";
        } else {
          modalCodeLink.style.display = "none";
        }
      }
      if (modalPreviewLink) {
        if (data.preview && data.preview !== "") {
          modalPreviewLink.href = data.preview;
          modalPreviewLink.style.display = "flex";
        } else {
          modalPreviewLink.style.display = "none";
        }
      }

      if (modalTechContainer) {
        modalTechContainer.innerHTML = "";
        const techs = Array.isArray(data.technologies) ? data.technologies : [];
        techs.forEach((t: { name: string; icon: string }) => {
          const badge = document.createElement("span");
          badge.className =
            "inline-flex items-center gap-2.5 text-sm font-medium text-zinc-200 hover:text-white transition-colors";
          badge.innerHTML = `
            <img src="${t.icon}" alt="${t.name}" class="size-6 object-contain" width="24" height="24" loading="lazy" />
            <span>${t.name}</span>
          `;
          modalTechContainer.appendChild(badge);
        });
      }

      modal.classList.remove("opacity-0", "pointer-events-none");
      modalCard.classList.remove("scale-95");
      modalCard.classList.add("scale-100");
    }

    function closeModal() {
      if (!modal || !modalCard) return;

      modal.classList.add("opacity-0", "pointer-events-none");
      modalCard.classList.remove("scale-100");
      modalCard.classList.add("scale-95");
    }

    modal.addEventListener(
      "wheel",
      (e) => {
        if (!modalCard.contains(e.target as Node)) {
          e.preventDefault();
        }
      },
      { passive: false }
    );

    modal.addEventListener(
      "touchmove",
      (e) => {
        if (!modalCard.contains(e.target as Node)) {
          e.preventDefault();
        }
      },
      { passive: false }
    );

    document.querySelectorAll(".project-card").forEach((card) => {
      card.addEventListener("click", (e) => {
        const target = e.target as HTMLElement;
        if (target.closest(".project-direct-btn")) {
          return;
        }

        const dataAttr = card.getAttribute("data-project");
        if (dataAttr) {
          try {
            const data = JSON.parse(dataAttr);
            openModal(data);
          } catch (err) {
            console.error("Error al leer datos del proyecto:", err);
          }
        }
      });
    });

    closeBtn.addEventListener("click", closeModal);
    backdrop.addEventListener("click", closeModal);

    window.addEventListener("keydown", (e) => {
      if (
        e.key === "Escape" &&
        modal &&
        !modal.classList.contains("pointer-events-none")
      ) {
        closeModal();
      }
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupProjectModal);
  } else {
    setupProjectModal();
  }
  document.addEventListener("astro:page-load", setupProjectModal);
</script>
