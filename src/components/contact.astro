---
// Contact section
---

<section id="contact" class="w-full py-12 border-t border-[#ffffff10]">
  <div class="max-w-5xl mx-auto">
    <h2 class="text-lg text-[var(--sec)] mb-2 shiny-sec">Hablemos</h2>
    <h3 class="text-4xl md:text-5xl font-medium text-[var(--white)] mb-6">
      Contacto
    </h3>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <div class="text-[var(--white-icon)]">
        <p class="mb-6 text-base leading-relaxed">
          ¿Tenés una pregunta? No dudes en escribirme, Estoy abierto a cualquier oportunidad: remoto, tiempo completo o colaboraciones.
        </p>

        <div class="space-y-4">
          <div class="flex items-center gap-3.5 group">
            <div
              class="size-10 rounded-xl bg-[#1414149c] border border-[var(--white-icon-tr)] flex items-center justify-center text-[var(--sec-bright)] flex-shrink-0 group-hover:border-[var(--sec)]/40 transition-colors"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="currentColor"
                class="size-5"
              >
                <path
                  d="M1.5 8.67v8.58a3 3 0 0 0 3 3h15a3 3 0 0 0 3-3V8.67l-8.928 5.493a3 3 0 0 1-3.144 0L1.5 8.67Z"
                ></path>
                <path
                  d="M22.5 6.908V6.75a3 3 0 0 0-3-3h-15a3 3 0 0 0-3 3v.158l9.714 5.978a1.5 1.5 0 0 0 1.572 0L22.5 6.908Z"
                ></path>
              </svg>
            </div>
            <div>
              <span class="text-xs text-[var(--white-icon)] block">Email</span>
              <a
                href="mailto:lautaroviscarradev@gmail.com"
                class="text-[var(--white)] hover:text-[var(--sec-bright)] transition-colors font-medium break-all"
              >
                lautaroviscarradev@gmail.com
              </a>
            </div>
          </div>

          <div class="flex items-center gap-3.5 group">
            <div
              class="size-10 rounded-xl bg-[#1414149c] border border-[var(--white-icon-tr)] flex items-center justify-center text-[var(--sec-bright)] flex-shrink-0 group-hover:border-[var(--sec)]/40 transition-colors"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="currentColor"
                class="size-5"
              >
                <path
                  d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.03 14.69 2 12.04 2M12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.58 20.15 12.04 20.15C10.56 20.15 9.11 19.76 7.85 19L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.29C4.24 15 3.8 13.47 3.8 11.91C3.81 7.37 7.5 3.67 12.05 3.67M8.53 7.33C8.37 7.33 8.1 7.39 7.87 7.64C7.65 7.89 7.02 8.48 7.02 9.68C7.02 10.88 7.89 12.04 8.01 12.2C8.13 12.37 9.71 14.81 12.13 15.86C14.15 16.73 14.56 16.56 15 16.52C15.44 16.47 16.42 15.93 16.62 15.36C16.82 14.79 16.82 14.3 16.76 14.2C16.7 14.1 16.54 14.04 16.3 13.92C16.07 13.81 14.91 13.24 14.7 13.16C14.49 13.08 14.33 13.04 14.17 13.28C14.01 13.53 13.56 14.1 13.42 14.26C13.28 14.43 13.14 14.45 12.9 14.33C12.67 14.21 11.91 13.96 11.01 13.16C10.31 12.54 9.84 11.77 9.7 11.53C9.57 11.29 9.69 11.16 9.8 11.04C9.91 10.94 10.04 10.76 10.16 10.62C10.28 10.48 10.32 10.38 10.4 10.22C10.48 10.05 10.44 9.91 10.38 9.79C10.32 9.67 9.87 8.56 9.69 8.11C9.5 7.67 9.32 7.73 9.17 7.72C9.04 7.72 8.87 7.71 8.71 7.71L8.53 7.33Z"
                ></path>
              </svg>
            </div>
            <div>
              <span class="text-xs text-[var(--white-icon)] block">WhatsApp / Teléfono</span>
              <a
                href="https://wa.me/5493865665152"
                target="_blank"
                rel="noopener noreferrer"
                class="text-[var(--white)] hover:text-[var(--sec-bright)] transition-colors font-medium"
              >
                +54 3865 665152
              </a>
            </div>
          </div>

          <div class="flex items-center gap-3.5 group">
            <div
              class="size-10 rounded-xl bg-[#1414149c] border border-[var(--white-icon-tr)] flex items-center justify-center text-[var(--sec-bright)] flex-shrink-0 group-hover:border-[var(--sec)]/40 transition-colors"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="currentColor"
                class="size-5"
              >
                <path
                  fill-rule="evenodd"
                  d="m11.54 22.351.07.04.028.016a.76.76 0 0 0 .723 0l.028-.015.071-.041a16.975 16.975 0 0 0 1.144-.742 19.58 19.58 0 0 0 2.683-2.282c1.944-1.99 3.963-4.98 3.963-8.827a8.25 8.25 0 0 0-16.5 0c0 3.846 2.02 6.837 3.963 8.827a19.58 19.58 0 0 0 2.682 2.282 16.975 16.975 0 0 0 1.145.742ZM12 13.5a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z"
                  clip-rule="evenodd"
                ></path>
              </svg>
            </div>
            <div>
              <span class="text-xs text-[var(--white-icon)] block">Ubicación</span>
              <span class="text-[var(--white)] font-medium">Concepción, Tucumán, Argentina</span>
            </div>
          </div>
        </div>
      </div>

      <div>
        <form
          id="contact-form"
          class="flex flex-col gap-4"
        >
          <!-- Campo Honeypot para evitar spam de bots (invisible para usuarios) -->
          <div class="hidden" aria-hidden="true">
            <input
              type="text"
              name="_honey"
              tabindex="-1"
              autocomplete="off"
            />
          </div>

          <input
            type="text"
            name="from_name"
            placeholder="Nombre"
            required
            class="px-4 py-2 bg-[#1414149c] text-[var(--white)] border border-[var(--white-icon-tr)] rounded-lg focus:outline-none focus:ring-2 focus:ring-[var(--sec)]"
          />
          <input
            type="email"
            name="from_email"
            placeholder="Email"
            required
            class="px-4 py-2 bg-[#1414149c] text-[var(--white)] border border-[var(--white-icon-tr)] rounded-lg focus:outline-none focus:ring-2 focus:ring-[var(--sec)]"
          />
          <input
            type="text"
            name="subject"
            placeholder="Asunto"
            required
            class="px-4 py-2 bg-[#1414149c] text-[var(--white)] border border-[var(--white-icon-tr)] rounded-lg focus:outline-none focus:ring-2 focus:ring-[var(--sec)]"
          />
          <textarea
            name="message"
            placeholder="Mensaje"
            rows="6"
            required
            class="px-4 py-2 bg-[#1414149c] text-[var(--white)] border border-[var(--white-icon-tr)] rounded-lg focus:outline-none focus:ring-2 focus:ring-[var(--sec)] resize-none"
          ></textarea>
          <button
            id="contact-submit-btn"
            type="submit"
            class="px-4 py-2.5 bg-[var(--white-icon-tr)] text-[var(--white)] rounded-lg opacity-80 transition-all border border-[var(--white-icon-tr)] hover:opacity-100 hover:bg-[var(--white-icon-tr)] cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed font-medium"
          >
            Enviar mensaje
          </button>
        </form>
        <div
          id="form-status"
          class="hidden text-emerald-400 text-base md:text-lg font-medium text-center py-8"
        ></div>
      </div>
    </div>
  </div>
</section>

<script>
  import emailjs from "@emailjs/browser";

  function setupEmailJSForm() {
    const form = document.getElementById("contact-form") as HTMLFormElement | null;
    const submitBtn = document.getElementById("contact-submit-btn") as HTMLButtonElement | null;
    const formStatus = document.getElementById("form-status");

    if (!form || !submitBtn || !formStatus) return;

    const COOLDOWN_MS = 2 * 60 * 1000;
    const STORAGE_KEY = "last_contact_submission";

    const lastSubmission = localStorage.getItem(STORAGE_KEY);
    if (lastSubmission) {
      const elapsed = Date.now() - parseInt(lastSubmission, 10);
      if (elapsed < COOLDOWN_MS) {
        form.style.display = "none";
        formStatus.className =
          "flex justify-center items-center py-8 text-emerald-400 text-base md:text-lg font-medium text-center";
        formStatus.textContent =
          "✅ ¡Gracias por tu mensaje! Me pondré en contacto pronto.";
      }
    }

    const publicKey = import.meta.env.PUBLIC_EMAILJS_PUBLIC_KEY;
    const serviceId = import.meta.env.PUBLIC_EMAILJS_SERVICE_ID;
    const templateId = import.meta.env.PUBLIC_EMAILJS_TEMPLATE_ID;

    if (publicKey && publicKey !== "tu_public_key") {
      emailjs.init({ publicKey });
    }

    form.addEventListener("submit", (e) => {
      e.preventDefault();

      const honey = (form.elements.namedItem("_honey") as HTMLInputElement | null)?.value;
      if (honey) {
        form.reset();
        form.style.display = "none";
        formStatus.className =
          "flex justify-center items-center py-8 text-emerald-400 text-base md:text-lg font-medium text-center";
        formStatus.textContent =
          "✅ ¡Gracias por tu mensaje! Me pondré en contacto pronto.";
        return;
      }

      const recentSubmission = localStorage.getItem(STORAGE_KEY);
      if (recentSubmission) {
        const elapsed = Date.now() - parseInt(recentSubmission, 10);
        if (elapsed < COOLDOWN_MS) {
          const remainingSeconds = Math.ceil((COOLDOWN_MS - elapsed) / 1000);
          formStatus.className = "mt-3 text-amber-400 text-sm text-center block";
          formStatus.textContent = `Ya enviaste un mensaje hace un momento. Por favor espera ${remainingSeconds} segundos antes de enviar otro.`;
          return;
        }
      }

      if (
        !publicKey ||
        !serviceId ||
        !templateId ||
        publicKey === "tu_public_key" ||
        serviceId === "tu_service_id" ||
        templateId === "tu_template_id"
      ) {
        formStatus.className = "mt-3 text-amber-400 text-sm text-center block";
        formStatus.textContent =
          "Configura tus credenciales reales (PUBLIC_EMAILJS_PUBLIC_KEY, etc.) en el archivo .env.";
        return;
      }

      const originalText = submitBtn.textContent || "Enviar mensaje";

      submitBtn.disabled = true;
      submitBtn.textContent = "Enviando...";
      formStatus.className = "hidden";

      emailjs
        .sendForm(serviceId, templateId, form)
        .then(() => {
          localStorage.setItem(STORAGE_KEY, Date.now().toString());
          form.reset();
          form.style.display = "none";
          formStatus.className =
            "flex justify-center items-center py-8 text-emerald-400 text-base md:text-lg font-medium text-center";
          formStatus.textContent =
            "✅ ¡Gracias por tu mensaje! Me pondré en contacto pronto.";
        })
        .catch((error) => {
          console.error("EmailJS Error:", error);
          formStatus.className =
            "mt-3 text-rose-400 text-sm text-center block";
          formStatus.textContent =
            "❌ Ocurrió un error al enviar el mensaje. Intenta nuevamente o contáctame directamente por email.";
        })
        .finally(() => {
          submitBtn.disabled = false;
          submitBtn.textContent = originalText;
        });
    });
  }

  setupEmailJSForm();
  document.addEventListener("astro:page-load", setupEmailJSForm);
</script>
