---
// Native Astro LikeButton Component
---

<div class="flex items-center" id="like-button-container">
  <button
    id="portfolio-like-btn"
    type="button"
    class="group relative w-40 h-10 flex items-center justify-center p-3 rounded-full transition-all duration-300 ease-in-out transform border-2 border-[var(--white-icon)] hover:scale-105 hover:border-[var(--white)] cursor-pointer focus:outline-none"
    aria-label="Dar me gusta"
  >
    <svg
      id="like-heart-icon"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="currentColor"
      class="w-6 h-6 transition-all duration-300 ease-in-out text-[var(--white-icon)] group-hover:text-[var(--white)] group-hover:scale-105"
    >
      <path
        d="M16.5 3C19.5376 3 22 5.5 22 9C22 16 14.5 20 12 21.5C9.5 20 2 16 2 9C2 5.5 4.5 3 7.5 3C9.35997 3 11 4 12 5C13 4 14.64 3 16.5 3ZM12.9339 18.6038C13.8155 18.0485 14.61 17.4955 15.3549 16.9029C18.3337 14.533 20 11.9435 20 9C20 6.64076 18.463 5 16.5 5C15.4241 5 14.2593 5.56911 13.4142 6.41421L12 7.82843L10.5858 6.41421C9.74068 5.56911 8.5759 5 7.5 5C5.55906 5 4 6.6565 4 9C4 11.9435 5.66627 14.533 8.64514 16.9029C9.39 17.4955 10.1845 18.0485 11.0661 18.6038C11.3646 18.7919 11.6611 18.9729 12 19.1752C12.3389 18.9729 12.6354 18.7919 12.9339 18.6038Z"
      ></path>
    </svg>
    <span
      id="like-count-text"
      class="text-sm pl-3 font-medium text-[var(--white)]"
    >
      42 Likes
    </span>
  </button>
</div>

<script>
  function setupLikeButton() {
    const btn = document.getElementById("portfolio-like-btn") as HTMLButtonElement | null;
    const heart = document.getElementById("like-heart-icon");
    const countText = document.getElementById("like-count-text");

    if (!btn || !heart || !countText) return;

    let likes = 42;
    const storedLikes = localStorage.getItem("websiteLikesCount");
    const storedIsLiked = localStorage.getItem("websiteIsLiked") === "true";

    if (storedLikes) {
      likes = parseInt(storedLikes, 10);
    }
    countText.textContent = `${likes} Likes`;

    if (storedIsLiked) {
      applyLikedState();
    }

    function applyLikedState() {
      btn?.classList.remove("border-[var(--white-icon)]", "hover:scale-105", "hover:border-[var(--white)]", "cursor-pointer");
      btn?.classList.add("border-[var(--sec)]", "cursor-default");
      heart?.classList.remove("text-[var(--white-icon)]", "group-hover:text-[var(--white)]", "group-hover:scale-105");
      heart?.classList.add("text-[var(--sec)]", "scale-110");
      btn?.setAttribute("disabled", "true");
    }

    btn.addEventListener("click", () => {
      if (localStorage.getItem("websiteIsLiked") === "true") return;

      likes += 1;
      countText.textContent = `${likes} Likes`;
      localStorage.setItem("websiteIsLiked", "true");
      localStorage.setItem("websiteLikesCount", likes.toString());

      applyLikedState();
      btn.classList.add("animate-heart-pulse");
      setTimeout(() => {
        btn.classList.remove("animate-heart-pulse");
      }, 600);
    });
  }

  setupLikeButton();
</script>
