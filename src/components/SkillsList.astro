---
const skills = [
  {
    category: "Desarrollo Web",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[var(--sec)]"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="M6 8h.01"/><path d="M10 8h.01"/><path d="M14 8h.01"/></svg>`,
    items: [
      "Aplicaciones Web & SPAs",
      "Landing pages y sitios institucionales",
      "Sitios y portfolios interactivos de alto rendimiento",
    ],
  },
];
---

<div class="text-left pt-3 md:pt-9">
  <h3 class="text-[var(--white)] text-3xl md:text-4xl font-semibold md:mb-6">
    ¿Qué hago?
  </h3>
  <div class="mt-4">
    {
      skills.map((skill) => (
        <div class="md:w-[400px] w-full bg-[#1414149c] rounded-2xl p-5 text-left border border-[var(--white-icon-tr)] transition-all hover:border-[var(--sec)]/40">
          <div class="flex items-center gap-3 mb-4">
            <div class="flex-shrink-0" set:html={skill.icon} />
            <h4 class="text-[var(--white)] text-xl font-medium">
              {skill.category}
            </h4>
          </div>

          <ul class="space-y-2.5 text-[var(--white-icon)] text-sm">
            {skill.items.map((item) => (
              <li class="flex items-start">
                <span class="text-[var(--sec)] pr-2 font-bold">•</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</div>
